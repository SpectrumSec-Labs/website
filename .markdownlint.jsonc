{
  // Markdown style rules for blog, news, and docs content.
  // Enforced in CI; run `npx markdownlint-cli2 "content/**/*.md" "docs/**/*.md"` locally.
  "default": true,
  "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
  "MD024": { "siblings_only": true },
  "MD033": { "allowed_elements": ["br", "kbd"] },
  "MD036": false, // placeholder copy uses *italic notes* deliberately
  "MD040": false, // ASCII diagrams / trees in docs have no language
  "MD041": false, // front matter provides the H1 context
  "MD046": { "style": "fenced" },
  "MD049": { "style": "asterisk" },
  "MD060": false  // table pipe-spacing pedantry
}
