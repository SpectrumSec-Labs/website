# Review routing. Replace the team handles with real GitHub teams or usernames
# before enabling branch protection (see docs/contributing.md).
#
# Rule of thumb: infra owns anything that can change how the site is built,
# deployed, or served; editors own words and images.

# Default: infra reviews everything not matched below.
*                       @SpectrumSec-Labs/infra

# Build, deploy, security-sensitive config
/.github/               @SpectrumSec-Labs/infra
/config/                @SpectrumSec-Labs/infra
/layouts/               @SpectrumSec-Labs/infra
/assets/                @SpectrumSec-Labs/infra
/deploy/                @SpectrumSec-Labs/infra
/tools/                 @SpectrumSec-Labs/infra
/tests/                 @SpectrumSec-Labs/infra
/.tool-versions         @SpectrumSec-Labs/infra
/config/feeds.yaml      @SpectrumSec-Labs/infra

# Content — editors review, infra not required
/content/blog/          @SpectrumSec-Labs/editors
/content/news/          @SpectrumSec-Labs/editors
/content/services/      @SpectrumSec-Labs/editors @SpectrumSec-Labs/infra
/data/authors.yaml      @SpectrumSec-Labs/editors
/data/whyus.yaml        @SpectrumSec-Labs/editors

# Automated news updates: no code owner, so a PR touching ONLY this file needs
# no human approval and can auto-merge once CI is green. The update-news
# workflow fails if the aggregator ever changes any other file.
/data/news.json
